gentoo_model <- lm(body_mass_kg ~ gentoo, data = penguins_20)
gf_jitter(body_mass_kg ~ gentoo, data = penguins_20, width = .1) \%>\%
  gf_model(gentoo_model) \%>\%
  gf_square_resid(gentoo_model, color = "firebrick")

